from pathlib import Path

configfile: "config.yaml"

# Apply the LDSC container as the default for every rule.
container: str(Path(config["workspace"]).resolve() / config["container"])

include: "rules/common.smk"
include: "rules/extract_de.smk"

if config["gene_set_module"] in ["coloc", "coloc_strict"]:
    include: "rules/gene_sets_coloc.smk"
elif config["gene_set_module"] == "l2g":
    include: "rules/gene_sets_l2g.smk"
elif config["gene_set_module"] == "programs":
    # Programmes ship their own annot/ld-score/heritability backend
    # (per-annotation cell-type-specific S-LDSC, study-independent LD scores).
    include: "rules/gene_sets_programs.smk"
else:
    raise ValueError(
        f"Unknown gene_set_module: {config['gene_set_module']!r}. "
        "Supported: 'coloc', 'coloc_strict', 'l2g', 'programs'. "
        "Add a new rules/gene_sets_<name>.smk to extend."
    )

include: "rules/sumstats.smk"

# The generic gene-set -> combined-annot -> h2 backend is for the coloc/l2g
# modules. The programs module supplies its own backend above.
if config["gene_set_module"] != "programs":
    include: "rules/annots.smk"
    include: "rules/ld_scores.smk"
    if config["filter_low_snp_annots"]:
        include: "rules/filter_annots.smk"
    include: "rules/heritability.smk"


if config["gene_set_module"] == "programs":
    rule all:
        input:
            PROGRAM_FINAL
else:
    rule all:
        input:
            expand(
                f"{LDSC_RESULTS_DIR}/{{study}}/{{cond}}_combined.results",
                study=STUDIES,
                cond=CONDITIONS,
            ),
