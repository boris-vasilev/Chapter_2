// Analysis parameters. Everything specific to the cluster is in the csd3 profile.
manifest.nextflowVersion = '>=24.04'    // apptainer scope needs >= 22.11

params {
    // Which runs: comma-separated; studies = null means all in the study table.
    studies    = null
    conditions = 'Rest,Stim8hr,Stim48hr'

    // Perturbation filters
    min_de_genes = 0
    min_cells    = 50
    on_target    = true     // on-target KD and significant on-target effect

    // Edge filters
    padj          = 0.05
    min_abs_z     = 2.0
    min_abs_logfc = 0.5
    min_reg_k     = 1       // anchors a regulator must hit
    min_tgt_k     = 1       // anchor knockdowns that must hit a target

    // Anchors and annotations
    cell_type          = 'CD4'
    h4_threshold       = 0.8
    window_size        = 10000
    min_snps_per_annot = 1000

    // Existing DE table to reuse instead of extracting (relative to workspace).
    // The output folder name reflects the filters above, not this table.
    de_results = null
    keep_ld    = true
    chain_cpus = 8
    outdir     = 'results'
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: EXTRACT_DE     { cpus = 4; memory = 64.GB; time = 2.h }
    withName: MAKE_GENE_SETS { cpus = 1; memory = 8.GB;  time = 30.m }
    withName: MUNGE_SUMSTATS { cpus = 1; memory = 8.GB;  time = 30.m }
    withLabel: chain         { cpus = params.chain_cpus; memory = 16.GB; time = 90.m }
}

env {
    // Parallelism comes from processes; inherited BLAS threads cause thrashing.
    OMP_NUM_THREADS      = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS      = '1'
    NUMEXPR_NUM_THREADS  = '1'
    LC_ALL               = 'C.UTF-8'    // for SCZ_Pardiñas
    LANG                 = 'C.UTF-8'
}

profiles {
    local {
        process.executor = 'local'
    }

    csd3 {
        params {
            workspace    = '/rds/project/rds-csoP2nj6Y6Y/biv22/perturb_heritability_model'
            outdir       = '/rds/project/rds-csoP2nj6Y6Y/biv22/Chapter_2/results/ldsc'
            ldsc_dir     = '/app/ldsc'      // inside the container

            // Relative to workspace
            de_h5ad      = 'data/GWCD4i.DE_stats.h5ad'
            coloc_dat    = 'data/coloc_dat.tsv'
            study_info   = 'data/GWAS_study_info.csv'
            gwas_dir     = 'data/GWAS'
            sumstats_dir = 'data/sumstats'

            gene_coord = [GRCh37: 'data/gene_coord.txt', GRCh38: 'data/gene_coord_hg38.txt']
            snp_list   = [EUR: 'data/hm3_no_MHC.list.txt', EAS: 'data/hm3_EAS_no_MHC.list.txt']
            bim = [EUR_GRCh37: 'data/GRCh37/1000G_Phase3_plink/1000G.EUR.QC',
                   EAS_GRCh37: 'data/GRCh37_EAS/1000G_Phase3_plink/1000G.EAS.QC',
                   EUR_GRCh38: 'data/GRCh38/1000G_Phase3_plink/1000G.EUR.hg38']
            baseline_ld = [EUR_GRCh37: 'data/GRCh37/baselineLD_v2.2/baselineLD.',
                           EUR_GRCh38: 'data/GRCh38/baselineLD_v2.2/baselineLD.',
                           EAS_GRCh37: 'data/GRCh37_EAS/baselineLD_v2.2/baselineLD.']
            weights = [EUR_GRCh37: 'data/GRCh37/1000G_Phase3_weights_hm3_no_MHC/weights.hm3_noMHC.',
                       EUR_GRCh38: 'data/GRCh38/1000G_Phase3_weights_hm3_no_MHC/weights.hm3_noMHC.',
                       EAS_GRCh37: 'data/GRCh37_EAS/1000G_Phase3_weights_hm3_no_MHC/weights.EAS.hm3_noMHC.']
            allele_frq = [EUR_GRCh37: 'data/GRCh37/1000G_Phase3_plink/1000G.EUR.QC.',
                          EUR_GRCh38: 'data/GRCh38/1000G_Phase3_plink/1000G.EUR.hg38.',
                          EAS_GRCh37: 'data/GRCh37_EAS/1000G_Phase3_plink/1000G.EAS.QC.']
        }

        process {
            executor       = 'slurm'
            queue          = 'icelake'
            clusterOptions = '-A MRC-BSU2-SL2-CPU'
            container      = '/rds/project/rds-csoP2nj6Y6Y/biv22/Chapter_2/containers/ldsc39_env.sif'
            withLabel: chain { scratch = true }     // intermediates stay on the node
            withLabel: '!chain' {
                container = '/rds/project/rds-csoP2nj6Y6Y/biv22/Chapter_2/containers/extract_de_env.sif'
            }
        }

        apptainer {
            enabled    = true
            autoMounts = true
            runOptions = '--fakeroot -B /rds/project/rds-csoP2nj6Y6Y:/rds/project/rds-csoP2nj6Y6Y -B /home/biv22/rds/rds-mrc-bsu-csoP2nj6Y6Y:/home/biv22/rds/rds-mrc-bsu-csoP2nj6Y6Y'
        }

        // CSD3 asks for >= 2 min between automated squeue calls. Completion is
        // read from .exitcode files, so polling does not touch the scheduler.
        executor {
            queueSize         = 40
            pollInterval      = '30 sec'
            queueStatInterval = '3 min'
            submitRateLimit   = '60/1min'
            exitReadTimeout   = '5 min'
        }
    }
}
