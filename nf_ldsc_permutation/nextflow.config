// Permutation settings on top of the main pipeline's config, which supplies the edge
// filters, reference paths and the csd3 profile. Defaults are the Stage 2 runs.
includeConfig '../nf_ldsc_pipeline/nextflow.config'

params {
    // Study -> conditions. --studies and --conditions select a subset.
    runs = [AITD_Saevarsdottir_32581359_1: ['Rest', 'Stim8hr', 'Stim48hr'],
            ASTCO_Ferreira_30929738_1:     ['Rest', 'Stim48hr']]
    n_perm = 200        // perm indices 1..n_perm, plus real
    seed   = 42         // perm P, condition C: default_rng([seed + P, code(C)])

    // Matching: zero bin + n_degree_bins quantile bins for in- and out-degree,
    // n_expr_bins for expression; knocked-down anchors draw from the knn_k nearest.
    n_degree_bins = 4
    n_expr_bins   = 5
    knn_k         = 20

    // Real sets must equal these (relative to workspace); null skips the check.
    reference_gene_sets = null

    // Relative to workspace. Outputs go to {perm_root}/{tag}/.
    perm_root      = 'data/permutations'
    expression_dir = 'data/permutations/inputs'
    protein_coding_coord = [GRCh37: 'data/gene_coord_protein_coding.txt',
                            GRCh38: 'data/gene_coord_protein_coding_hg38.txt']

    keep_ld = false         // ~70 MB per chain otherwise
    gene_sets_only = false  // stop after PERM_GENE_SETS (validation)
}

process {
    withName: BUILD_EXPRESSION { cpus = 1; memory = 32.GB; time = 1.h }
    withName: PERM_GENE_SETS   { cpus = 1; memory = 16.GB; time = 2.h }
    withName: COLLECT          { cpus = 1; memory = 8.GB;  time = 1.h }
}
