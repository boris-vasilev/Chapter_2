Bootstrap: docker
From: ghcr.io/astral-sh/uv:python3.12-bookworm-slim

%post
    export UV_PYTHON_DOWNLOADS=never
    uv venv /opt/venv --python python3.12
    uv pip install --python /opt/venv/bin/python \
        scanpy==1.10.3 anndata h5py polars numpy pandas

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONNOUSERSITE=1
    export NUMBA_CACHE_DIR=/tmp/numba_cache    # numba needs a writable cache dir
    export MPLCONFIGDIR=/tmp/matplotlib        # same for matplotlib